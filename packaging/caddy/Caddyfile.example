{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	@githook {
		method POST
		path {$GITHOOK_WEBHOOK_PATH:/hooks/github}
	}
	reverse_proxy @githook {$GITHOOK_UPSTREAM:127.0.0.1:4000}

	root * {$SITE_ROOT}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}

	file_server
}
